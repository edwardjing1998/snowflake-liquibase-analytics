<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.att.analytics</groupId>
    <artifactId>snowflake-liquibase-analytics</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <liquibase.version>4.33.0</liquibase.version>
        <snowflake.jdbc.version>3.24.0</snowflake.jdbc.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <version>${liquibase.version}</version>
                <configuration>
                    <changeLogFile>src/main/resources/db/changelog/db.changelog-master.xml</changeLogFile>
                    <driver>net.snowflake.client.jdbc.SnowflakeDriver</driver>
                    <url>jdbc:snowflake://${env.SNOWFLAKE_ACCOUNT}.snowflakecomputing.com/?db=${env.SNOWFLAKE_DATABASE}&amp;schema=${env.SNOWFLAKE_CHANGELOG_SCHEMA}&amp;warehouse=${env.SNOWFLAKE_WAREHOUSE}&amp;role=${env.SNOWFLAKE_ROLE}</url>
                    <username>${env.SNOWFLAKE_USER}</username>
                    <password>${env.SNOWFLAKE_PASSWORD}</password>
                    <defaultSchemaName>${env.SNOWFLAKE_CHANGELOG_SCHEMA}</defaultSchemaName>
                    <liquibaseSchemaName>${env.SNOWFLAKE_CHANGELOG_SCHEMA}</liquibaseSchemaName>
                    <databaseChangeLogTableName>DATABASECHANGELOG</databaseChangeLogTableName>
                    <databaseChangeLogLockTableName>DATABASECHANGELOGLOCK</databaseChangeLogLockTableName>
                    <expressionVariables>
                        <databaseName>${env.SNOWFLAKE_DATABASE}</databaseName>
                    </expressionVariables>
                    <promptOnNonLocalDatabase>false</promptOnNonLocalDatabase>
                    <logLevel>info</logLevel>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>net.snowflake</groupId>
                        <artifactId>snowflake-jdbc</artifactId>
                        <version>${snowflake.jdbc.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
