<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-01-create-dim-policy" author="edward">
        <createTable catalogName="${databaseName}" schemaName="CORE" tableName="DIM_POLICY"
                     remarks="Versioned policy analytical dimension">
            <column name="POLICY_SK" type="NUMBER" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="PK_DIM_POLICY" nullable="false"/>
            </column>
            <column name="POLICY_ID" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="POLICY_VERSION" type="NUMBER"><constraints nullable="false"/></column>
            <column name="POLICY_NAME" type="VARCHAR(500)"/>
            <column name="POLICY_TYPE" type="VARCHAR(100)"/>
            <column name="CATEGORY" type="VARCHAR(100)"/>
            <column name="STATUS" type="VARCHAR(50)"/>
            <column name="POLICY_SUMMARY" type="VARCHAR"/>
            <column name="POLICY_TEXT" type="VARCHAR"/>
            <column name="EFFECTIVE_START_DATE" type="DATE"/>
            <column name="EFFECTIVE_END_DATE" type="DATE"/>
            <column name="IS_CURRENT" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="SOURCE_SYSTEM" type="VARCHAR(100)"/>
            <column name="SOURCE_REFERENCE" type="VARCHAR(1000)"/>
            <column name="SOURCE_UPDATED_AT" type="TIMESTAMP_NTZ"/>
            <column name="LOAD_BATCH_ID" type="VARCHAR(100)"/>
            <column name="CREATED_AT" type="TIMESTAMP_NTZ" defaultValueComputed="CURRENT_TIMESTAMP()"/>
            <column name="UPDATED_AT" type="TIMESTAMP_NTZ" defaultValueComputed="CURRENT_TIMESTAMP()"/>
        </createTable>
        <addUniqueConstraint catalogName="${databaseName}" schemaName="CORE"
                             tableName="DIM_POLICY" columnNames="POLICY_ID,POLICY_VERSION"
                             constraintName="UK_DIM_POLICY_VERSION"/>
        <rollback><dropTable catalogName="${databaseName}" schemaName="CORE" tableName="DIM_POLICY"/></rollback>
    </changeSet>

    <changeSet id="003-02-create-policy-product-bridge" author="edward">
        <createTable catalogName="${databaseName}" schemaName="CORE" tableName="BRIDGE_POLICY_PRODUCT">
            <column name="POLICY_SK" type="NUMBER"><constraints nullable="false"/></column>
            <column name="PRODUCT_ID" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="RELATIONSHIP_TYPE" type="VARCHAR(100)"/>
            <column name="EFFECTIVE_START_DATE" type="DATE"/>
            <column name="EFFECTIVE_END_DATE" type="DATE"/>
            <column name="LOAD_BATCH_ID" type="VARCHAR(100)"/>
            <column name="CREATED_AT" type="TIMESTAMP_NTZ" defaultValueComputed="CURRENT_TIMESTAMP()"/>
        </createTable>
        <rollback><dropTable catalogName="${databaseName}" schemaName="CORE" tableName="BRIDGE_POLICY_PRODUCT"/></rollback>
    </changeSet>
</databaseChangeLog>
